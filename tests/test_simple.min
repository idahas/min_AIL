!print "=== MIN LANGUAGE TESTS ==="

!print "--- Variables ---"
:x 42
:y 3.14
!print (+ "x = " x)
!print (+ "y = " y)

!print "--- Arithmetic ---"
!print (+ "3 + 4 = " (+ 3 4))
!print (+ "10 - 3 = " (- 10 3))
!print (+ "5 * 6 = " (* 5 6))
!print (+ "20 / 4 = " (/ 20 4))

!print "--- Comparison ---"
!print (+ "5 = 5 is " (= 5 5))
!print (+ "5 > 3 is " (> 5 3))

!print "--- Strings ---"
:x "Hello"
:y "World"
!print (+ x (+ " " y))

!print "--- Arrays ---"
:arr [1:2:3:4:5]
!print (+ "Array: " arr)
!print (+ "Index 2: " (. arr 2))

!print "--- Functions ---"
@add(a b) [+ a b]
@factorial(n) [
  ? (= n 0) [1]
    !else [* n (@factorial((- n 1)))]
]
!print (+ "add(3, 4) = " (@add(3:4)))
!print (+ "factorial(5) = " (@factorial(5)))

!print "--- Loops ---"
:sum 0
!for [i 1 11] [
  :sum (+ sum i)
]
!print (+ "Sum 1..10 = " sum)

!print "--- Conditionals ---"
:x 10
? (> x 5) [
  !print "x is greater than 5"
] [
  !print "x is 5 or less"
]

!print "--- Objects ---"
:person {name:"John" age:30}
!print (+ "Name: " (. person name))

!print "--- Classes ---"
!class Dog
  name:""
  @init(n) [:name n]
  @bark() [!print (+ name " says Woof!")]
]

:dog (!new Dog("Rex"))
! dog bark

!print "=== ALL TESTS PASSED ==="
