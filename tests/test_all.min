!print "=== MIN LANGUAGE TESTS ==="
!print ""

!print "--- Variables ---"
:x 42
:y 3.14
:name "Min"
:flag #true
!print (+ "x = " x)
!print (+ "y = " y)
!print (+ "name = " name)
!print (+ "flag = " flag)
!print ""

!print "--- Arithmetic ---"
!print (+ "3 + 4 = " (+ 3 4))
!print (+ "10 - 3 = " (- 10 3))
!print (+ "5 * 6 = " (* 5 6))
!print (+ "20 / 4 = " (/ 20 4))
!print (+ "17 % 5 = " (% 17 5))
!print ""

!print "--- Comparison ---"
!print (+ "5 = 5 is " (= 5 5))
!print (+ "5 > 3 is " (> 5 3))
!print (+ "5 < 3 is " (< 5 3))
!print ""

!print "--- Strings ---"
:x "Hello"
:y "World"
!print (+ x (+ " " y))
!print (+ "Length: " (! len x))
!print ""

!print "--- Arrays ---"
:arr [1 2 3 4 5]
!print (+ "Array: " arr)
!print (+ "Length: " (! len arr))
!print (+ "Index 2: " (. arr 2))
! arr push 6
!print (+ "After push: " arr)
!print ""

!print "--- Functions ---"
@add(a b) [+ a b]
@factorial(n) [
  ? (= n 0) [1]
    [* n (@factorial (- n 1))]
]
!print (+ "add(3, 4) = " (@add 3 4))
!print (+ "factorial(5) = " (@factorial 5))
!print ""

!print "--- Loops ---"
:sum 0
!for [i 1 11] [
  :sum (+ sum i)
]
!print (+ "Sum 1..10 = " sum)

:count 0
!while [< count 5] [
  :count (+ count 1)
]
!print (+ "Count = " count)
!print ""

!print "--- Conditionals ---"
:x 10
? (> x 5) [
  !print "x is greater than 5"
] [
  !print "x is 5 or less"
]
!print ""

!print "--- Objects ---"
:person {name:"John" age:30 city:"NYC"}
!print (+ "Name: " (. person name))
!print (+ "Age: " (. person age))
: person city "Boston"
!print (+ "New city: " (. person city))
!print ""

!print "--- Classes ---"
!class Dog
  name:""
  @init(n) [:name n]
  @bark() !print (+ name " says Woof!")

:dog (!new Dog "Rex")
! dog bark
!print ""

!print "--- Built-in Functions ---"
!print (+ "type(42) = " (! type 42))
!print (+ "str(3.14) = " (! str 3.14))
!print (+ "int(3.9) = " (! int 3.9))
!print (+ "abs(-5) = " (! abs -5))
!print (+ "sqrt(16) = " (! sqrt 16))
!print ""

!print "=== ALL TESTS PASSED ==="
